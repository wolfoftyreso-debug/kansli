# Kansli web (OIDC client / BFF) configuration.
# Copy to .env.local for development. Defaults match `pnpm dev:idp`.

PIXDRIFT_ISSUER=http://127.0.0.1:4000
PIXDRIFT_CLIENT_ID=kansli-web
PIXDRIFT_CLIENT_SECRET=kansli-dev-secret
PIXDRIFT_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
APP_BASE_URL=http://127.0.0.1:3000

# Signs Kansli's own session cookie. Use a long random value in production.
APP_SESSION_SECRET=kansli-dev-app-session-secret-byt-ut-i-drift-0001

# Set to true when served over HTTPS so cookies get the Secure attribute.
COOKIE_SECURE=false

# --- Postgres (names only; never commit values) ------------------------------
# DATABASE_URL=                 # app role, runtime
# PIXDRIFT_DB_OWNER_URL=        # owner role, bootstrap + migrate + backup
# PIXDRIFT_DB_APP_ROLE=pixdrift_app
# PIXDRIFT_SEED_DEMO=false
# PIXDRIFT_SUPERUSER_URL=       # optional; restore-drill create/drop helper
# CRON_SECRET=                  # TYRA reminder cron
# VERCEL_OIDC_TOKEN=            # Vercel injects this; local uses AI_GATEWAY_API_KEY
# APP_ENV=dev

# --- Pixdrift identity provider (packages/identity) ---
# ISSUER=http://127.0.0.1:4000
# PORT=4000
# SESSION_SECRET=dev-idp-session-secret-min-32-chars-0001
# CLIENT_ID=kansli-web
# CLIENT_SECRET=kansli-dev-secret
# REDIRECT_URIS=http://127.0.0.1:3000/api/auth/callback
# AUDIENCES=kansli-web,alva-plattform,rita-api

# --- AI-providers (reasoning-/intelligence-lagret) -------------------------
# HEMLIGHETER: fyll ALDRIG i värden här. Lägg dem i Secrets-panelen (Cloud
# Agent) och/eller i respektive produkts deploy-miljö. Se docs/AI-PROVIDERS.md.
# Kanoniska namn (samma i hela familjen):
# ANTHROPIC_API_KEY=      # Claude  — används av ALVA (ai-orkester), BRITT, RITA
# OPENAI_API_KEY=         # ChatGPT/OpenAI
# GEMINI_API_KEY=         # Google Gemini — används av ALVA:s ai-orkester
# MOONSHOT_API_KEY=       # Kimi (Moonshot) — OpenAI-kompatibel, provider "kimi"
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1   # valfritt (t.ex. .cn-endpoint)
#
# Alternativ (gemensam väg): en enda AI-Gateway-nyckel som routar till alla tre
# med failover/kostnadsspårning i stället för tre separata nycklar per produkt.
# Konsumeras av @pixdrift/ai-core som en OpenAI-kompatibel "gateway"-provider:
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_MODEL=anthropic/claude-opus-4.6

# --- Externa integrationer: kommunikation & geo ----------------------------
# HEMLIGHETER: fyll i i Secrets-panelen, aldrig här. Se docs/INTEGRATIONS.md.
# 46elks (SMS/röst) — HTTP Basic, två delar (API username + password):
# ELKS_API_USERNAME=
# ELKS_API_PASSWORD=
# Resend (transaktionsmejl) — Bearer-nyckel (re_...):
# RESEND_API_KEY=
# Mapbox (kartor/geokodning) — access token (pk.*/sk.*):
# MAPBOX_ACCESS_TOKEN=
# Apollo.io (B2B-/kontaktdata, framtida bruk) — API-nyckel (X-Api-Key):
# APOLLO_API_KEY=

# --- RITA analysis engine ----------------------------------------------------
# Production (Vercel → host): the Rust binary cannot run inside a Node function.
# RITA_ENGINE_URL=https://rita-engine.example
# RITA_ENGINE_TOKEN=
# Local subprocess (real skattjakt-analyze, never FakeAnalysisEngine):
# RITA_ENGINE_BINARY=/absolute/path/to/skattjakt-analyze
# ANTHROPIC_API_KEY=            # utan den kör skattjakt bara regelverket
# SKATTJAKT_MODEL_ID=claude-fable-5
# SKATTJAKT_MODEL_PRICES=       # JSON model→pris; sätts till takpris om tomt
# SKATTJAKT_MODEL_TIMEOUT_SECS=180
# SKATTJAKT_MODEL_MAX_RETRIES=0
# SKATTJAKT_ANALYSIS_BUDGET_SEK=25

# --- Ekonomi rails (empty = blocked, never fake a payment) -------------------
# STRIPE_SECRET_KEY=            # or STRIPE_RESTRICTED_KEY (rk_ preferred)
# STRIPE_RESTRICTED_KEY=
# REVOLUT_BUSINESS_TOKEN=       # Business API READ — match incoming transfers
# REVOLUT_MERCHANT_SECRET=      # Merchant API — customer checkout (later)
# REVOLUT_BUSINESS_SANDBOX=true
# SWISH_PAYEE_ALIAS=            # not enough for Swish Handel
# EKONOMI_WRAP_KEY=             # encrypts tokens saved in /ekonomi/anslutningar
