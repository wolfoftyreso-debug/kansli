{
  "name": "@pixdrift/identity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pixdrift central identity provider — self-hosted OIDC (Authorization Code + PKCE, JWKS, userinfo).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@pixdrift/auth-core": "workspace:*",
    "@pixdrift/contracts": "workspace:*",
    "fastify": "^5.2.1",
    "jose": "^6.0.11",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@pixdrift/auth-client": "workspace:*",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.7"
  }
}
